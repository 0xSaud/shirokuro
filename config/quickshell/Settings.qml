// Everything adjustable in one place. Writes to settings.json, which the shell
// watches, so changes land immediately without a reload.
//
// Layout: sections down the left, one section's controls on the right. Nothing
// scrolls; pick a section and everything in it is on screen.
import QtQuick
import Quickshell
import Quickshell.Io

Overlay {
    id: win

    property var cfg
    property string page: "look"

    eyebrow: "SETTINGS"
    title: "Shell"
    hint: "saved as you change them"
    tint: th ? th.secondary : "#888"
    cardWidth: 880
    cardHeight: 580

    function shq(s) { return "'" + ("" + s).replace(/'/g, "'\\''") + "'" }

    // hypridle.conf is rewritten wholesale; idle behaviour is all-or-nothing and
    // partial edits of that file are harder to reason about than regenerating it.
    //
    // The keyboard is switched to English (layout 0) before any lock. Without
    // that, a lock that starts while Arabic is active takes the password in
    // Arabic and rejects it.
    function applyIdle(lockMin, offMin) {
        var en = "hyprctl switchxkblayout all 0; "
        var body = "general {\n" +
                   "    lock_cmd = " + en + "pidof hyprlock || " +
                   (win.cfg.locker === "quickshell" ? "qs ipc call lock engage" : "hyprlock") + "\n" +
                   "    before_sleep_cmd = " + en + "loginctl lock-session\n" +
                   "    after_sleep_cmd  = hyprctl dispatch dpms on\n" +
                   "}\n"
        if (lockMin > 0)
            body += "\nlistener {\n    timeout = " + (lockMin * 60) +
                    "\n    on-timeout = loginctl lock-session\n}\n"
        if (offMin > 0)
            body += "\nlistener {\n    timeout = " + (offMin * 60) +
                    "\n    on-timeout = hyprctl dispatch dpms off\n" +
                    "    on-resume = hyprctl dispatch dpms on\n}\n"
        Quickshell.execDetached(["bash", "-c",
            "printf '%s' " + shq("# AUTO-GENERATED by the shell settings panel\n" + body) +
            " > $HOME/.config/hypr/hypridle.conf && (pkill -x hypridle; setsid hypridle >/dev/null 2>&1 &)"])
    }

    readonly property var pages: [
        { id: "look",   label: "Look",        note: "Scheme, transparency, motion", glyph: "\uf1fc" },
        { id: "type",   label: "Type",        note: "Fonts and text size",          glyph: "\uf031" },
        { id: "bar",    label: "Bar",         note: "What the bar shows",           glyph: "\uf0c9" },
        { id: "alerts", label: "Alerts",      note: "Notifications and battery",    glyph: "\uf0f3" },
        { id: "lock",   label: "Lock & idle", note: "Lock screen and timers",       glyph: "\uf023" }
    ]

    // ---- small parts ----
    component Label: Text {
        color: win.th.outline
        font.family: win.th.body; font.pixelSize: win.th.fs(10); font.weight: Font.DemiBold
        topPadding: 6
    }
    component Note: Text {
        width: parent ? parent.width : 300
        wrapMode: Text.WordWrap
        color: win.th.outline
        font.family: win.th.body; font.pixelSize: win.th.fs(10)
        lineHeight: 1.2
    }
    // A row of chips where exactly one is chosen.
    component Choice: Row {
        id: ch
        property var options: []          // [{label, value}]
        property var current: null
        property var onPick: null
        width: parent ? parent.width : 300
        spacing: 6
        Repeater {
            model: ch.options
            Chip {
                required property var modelData
                th: win.th
                width: (ch.width - (ch.options.length - 1) * 6) / ch.options.length
                height: 36
                label: modelData.label
                on: ("" + modelData.value) === ("" + ch.current)
                onPick: function () { if (ch.onPick) ch.onPick(modelData.value) }
            }
        }
    }
    // An on/off line with a sliding switch.
    component Switch: Rectangle {
        id: sw
        property string label: ""
        property string note: ""
        property bool on: false
        property var onToggle: null
        width: parent ? parent.width : 300
        height: note.length > 0 ? 50 : 38
        radius: win.th.r
        color: swMa.containsMouse ? win.th.surfaceContainerHighest : win.th.surfaceContainer
        Column {
            x: 12
            anchors.verticalCenter: parent.verticalCenter
            width: parent.width - 70
            Text { text: sw.label; color: win.th.surfaceText
                   font.family: win.th.body; font.pixelSize: win.th.fs(12); font.weight: Font.DemiBold
                   width: parent.width; elide: Text.ElideRight }
            Text { text: sw.note; visible: text.length > 0; color: win.th.outline
                   font.family: win.th.body; font.pixelSize: win.th.fs(9)
                   width: parent.width; elide: Text.ElideRight }
        }
        Rectangle {
            anchors.verticalCenter: parent.verticalCenter
            anchors.right: parent.right
            anchors.rightMargin: 12
            width: 34; height: 18; radius: 9
            color: sw.on ? win.th.surfaceText : win.th.outlineVariant
            Behavior on color { ColorAnimation { duration: 140 } }
            Rectangle {
                y: 3; width: 12; height: 12; radius: 6
                x: sw.on ? 19 : 3
                color: sw.on ? win.th.primary : win.th.outline
                Behavior on x { NumberAnimation { duration: 140; easing.type: Easing.OutQuint } }
            }
        }
        MouseArea { id: swMa; anchors.fill: parent; hoverEnabled: true
                    cursorShape: Qt.PointingHandCursor
                    onClicked: if (sw.onToggle) sw.onToggle() }
    }

    Item {
        anchors.fill: parent

        // ================= sections =================
        Column {
            id: nav
            x: 16; y: 16
            width: 214
            spacing: 6
            Repeater {
                model: win.pages
                Rectangle {
                    id: navRow
                    required property var modelData
                    readonly property bool on: win.page === modelData.id
                    width: nav.width
                    height: 54
                    radius: win.th.rLarge
                    color: on ? win.th.surfaceText
                              : (navMa.containsMouse ? win.th.surfaceContainerHighest : win.th.surfaceContainerHigh)
                    Behavior on color { ColorAnimation { duration: 120 } }
                    Text {
                        x: 16
                        anchors.verticalCenter: parent.verticalCenter
                        width: 20
                        horizontalAlignment: Text.AlignHCenter
                        text: navRow.modelData.glyph
                        color: navRow.on ? win.th.primary : win.th.onSurfaceVariant
                        font.family: win.th.icon; font.pixelSize: win.th.fs(14)
                    }
                    Column {
                        x: 48
                        anchors.verticalCenter: parent.verticalCenter
                        width: parent.width - x - 8
                        Text { text: navRow.modelData.label
                               color: navRow.on ? win.th.surface : win.th.surfaceText
                               font.family: win.th.body; font.pixelSize: win.th.fs(12); font.weight: Font.DemiBold }
                        Text { text: navRow.modelData.note
                               color: navRow.on ? win.th.surfaceContainerHighest : win.th.outline
                               font.family: win.th.body; font.pixelSize: win.th.fs(9)
                               width: parent.width; elide: Text.ElideRight }
                    }
                    MouseArea { id: navMa; anchors.fill: parent; hoverEnabled: true
                                cursorShape: Qt.PointingHandCursor
                                onClicked: win.page = navRow.modelData.id }
                }
            }
        }

        // ================= the chosen section =================
        Tile {
            id: pane
            th: win.th
            x: nav.x + nav.width + 10
            y: 16
            width: parent.width - x - 16
            height: parent.height - 32

            // ---- Look ----
            Column {
                visible: win.page === "look"
                width: parent.width
                spacing: 6
                Label { text: "Scheme"; topPadding: 0 }
                Choice {
                    options: [{label: "Dark", value: "dark"}, {label: "Light", value: "light"}]
                    current: win.cfg.scheme
                    onPick: function (v) { win.cfg.set("scheme", v) }
                }
                Label { text: "Panel transparency" }
                Choice {
                    options: [{label: "Solid", value: 1.0}, {label: "Slight", value: 0.94},
                              {label: "Glassy", value: 0.86}, {label: "Sheer", value: 0.76}]
                    current: win.cfg.panelOpacity
                    onPick: function (v) { win.cfg.set("panelOpacity", v) }
                }
                Label { text: "Animation" }
                Choice {
                    options: [{label: "Off", value: 0.0}, {label: "Fast", value: 0.6},
                              {label: "Normal", value: 1.0}, {label: "Relaxed", value: 1.5}]
                    current: win.cfg.motion
                    onPick: function (v) { win.cfg.set("motion", v) }
                }
                Label { text: "Workspace numbers" }
                Choice {
                    options: [{label: "一 二 三   kanji", value: true}, {label: "1 2 3   digits", value: false}]
                    current: win.cfg.get("kanjiWorkspaces", true)
                    onPick: function (v) { win.cfg.set("kanjiWorkspaces", v) }
                }
                Item { width: 1; height: 4 }
                Note { text: "Colours are on their own panel: SUPER + T, or Control Center → Colours." }
            }

            // ---- Type ----
            Column {
                visible: win.page === "type"
                width: parent.width
                spacing: 6
                Label { text: "Typeface"; topPadding: 0 }
                Grid {
                    id: fontGrid
                    width: parent.width
                    columns: 3
                    spacing: 6
                    Repeater {
                        model: [
                            // Only families with static faces. Rubik, Adwaita Sans and
                            // Cantarell ship variable fonts under the same family name
                            // and Qt renders nothing at all for them. Vazirmatn is
                            // variable-only too, so Arabic falls back through
                            // fontconfig rather than being offered here.
                            { name: "Montserrat", display: "Montserrat",      body: "Open Sans" },
                            { name: "Open Sans",  display: "Open Sans",       body: "Open Sans" },
                            { name: "Red Hat",    display: "Red Hat Display", body: "Red Hat Text" },
                            { name: "Roboto",     display: "Roboto",          body: "Roboto" },
                            { name: "Comfortaa",  display: "Comfortaa",       body: "Open Sans" },
                            { name: "Serif",      display: "C059",            body: "Open Sans" }
                        ]
                        Rectangle {
                            id: fontCard
                            required property var modelData
                            readonly property bool sel: modelData.display === win.cfg.fontDisplay
                            width: (fontGrid.width - 12) / 3
                            height: 74
                            radius: win.th.r
                            color: sel ? win.th.surfaceText
                                       : (fontMa.containsMouse ? win.th.surfaceContainerHighest : win.th.surfaceContainer)
                            Behavior on color { ColorAnimation { duration: 120 } }
                            // Each card previews itself, so the choice is visible
                            // before it is applied.
                            Text {
                                x: 12; y: 10
                                text: "Aa"
                                font.family: fontCard.modelData.display
                                font.pixelSize: win.th.fs(24); font.weight: Font.Bold
                                color: fontCard.sel ? win.th.surface : win.th.surfaceText
                            }
                            Text {
                                x: 12
                                anchors.bottom: parent.bottom
                                anchors.bottomMargin: 9
                                width: parent.width - 24
                                elide: Text.ElideRight
                                text: fontCard.modelData.name
                                font.family: fontCard.modelData.body
                                font.pixelSize: win.th.fs(10)
                                color: fontCard.sel ? win.th.surfaceContainerHighest : win.th.outline
                            }
                            MouseArea {
                                id: fontMa
                                anchors.fill: parent
                                hoverEnabled: true
                                cursorShape: Qt.PointingHandCursor
                                onClicked: win.cfg.setFontPair(fontCard.modelData.display,
                                                               fontCard.modelData.body)
                            }
                        }
                    }
                }
                Label { text: "Figures and labels" }
                Choice {
                    options: [{label: "FiraCode", value: "FiraCode Nerd Font Propo"},
                              {label: "JetBrains", value: "JetBrains Mono"},
                              {label: "Source", value: "Source Code Pro"},
                              {label: "Adwaita", value: "Adwaita Mono"}]
                    current: win.cfg.fontMono
                    onPick: function (v) { win.cfg.set("fontMono", v) }
                }
                Label { text: "Text size" }
                Choice {
                    // Capped at 1.15: rows have fixed heights, and beyond that
                    // labels start clipping rather than getting more readable.
                    options: [{label: "Small", value: 0.92}, {label: "Normal", value: 1.0},
                              {label: "Large", value: 1.08}, {label: "Largest", value: 1.15}]
                    current: win.cfg.fontScale
                    onPick: function (v) { win.cfg.set("fontScale", v) }
                }
            }

            // ---- Bar ----
            Column {
                visible: win.page === "bar"
                width: parent.width
                spacing: 6
                Label { text: "Shown on the bar"; topPadding: 0 }
                Grid {
                    id: barGrid
                    width: parent.width
                    columns: 2
                    spacing: 6
                    Repeater {
                        model: [
                            { key: "showLauncher",   label: "Seal (launcher)" },
                            { key: "showWorkspaces", label: "Workspaces" },
                            { key: "showStats",      label: "System readings" },
                            { key: "showClock",      label: "Clock" },
                            { key: "showMedia",      label: "Now playing" },
                            { key: "showTaskbar",    label: "Open windows" },
                            { key: "showTray",       label: "System tray" },
                            { key: "showBattery",    label: "Battery" },
                            { key: "showVolume",     label: "Volume" },
                            { key: "showMic",        label: "Microphone" },
                            { key: "showLayout",     label: "Keyboard layout" },
                            { key: "showPower",      label: "Power button" }
                        ]
                        Switch {
                            required property var modelData
                            width: (barGrid.width - 6) / 2
                            label: modelData.label
                            on: win.cfg.get(modelData.key, true)
                            onToggle: function () { win.cfg.set(modelData.key, !win.cfg.get(modelData.key, true)) }
                        }
                    }
                }
                Item { width: 1; height: 2 }
                Note { text: "SUPER + B hides or shows the whole bar." }
            }

            // ---- Alerts ----
            Column {
                visible: win.page === "alerts"
                width: parent.width
                spacing: 6
                Label { text: "Notifications"; topPadding: 0 }
                Switch {
                    label: "Silent"; note: "Popups are hidden; the Control Center still keeps them"
                    on: win.cfg.dnd
                    onToggle: function () { win.cfg.set("dnd", !win.cfg.dnd) }
                }
                Label { text: "Warn when the battery drops below" }
                Choice {
                    options: [{label: "10%", value: 10}, {label: "15%", value: 15},
                              {label: "20%", value: 20}, {label: "30%", value: 30}]
                    current: win.cfg.batteryWarn
                    onPick: function (v) { win.cfg.set("batteryWarn", v) }
                }
            }

            // ---- Lock & idle ----
            Column {
                visible: win.page === "lock"
                width: parent.width
                spacing: 6
                Label { text: "Lock screen"; topPadding: 0 }
                Choice {
                    options: [{label: "Hyprlock", value: "hyprlock"},
                              {label: "Shell lock", value: "quickshell"}]
                    current: win.cfg.get("locker", "hyprlock")
                    onPick: function (v) { win.cfg.set("locker", v) }
                }
                Row {
                    spacing: 10
                    Chip {
                        th: win.th; strong: true; glyph: "\uf023"; label: "Lock now"
                        onPick: function () {
                            win.close()
                            Quickshell.execDetached(["bash", "-c",
                                "sleep 0.4; hyprctl switchxkblayout all 0; " +
                                (win.cfg.get("locker", "hyprlock") === "quickshell"
                                    ? "qs ipc call lock engage" : "loginctl lock-session")])
                        }
                    }
                    Text {
                        anchors.verticalCenter: parent.verticalCenter
                        text: "your password unlocks it"
                        color: win.th.outline
                        font.family: win.th.body; font.pixelSize: win.th.fs(10)
                    }
                }
                Label { text: "Lock after" }
                Choice {
                    options: [{label: "Never", value: 0}, {label: "10 min", value: 10},
                              {label: "20 min", value: 20}, {label: "45 min", value: 45}]
                    current: win.cfg.get("idleLockMin", 0)
                    onPick: function (v) {
                        win.cfg.set("idleLockMin", v)
                        win.applyIdle(v, win.cfg.get("idleOffMin", 0))
                    }
                }
                Label { text: "Screen off after" }
                Choice {
                    options: [{label: "Never", value: 0}, {label: "15 min", value: 15},
                              {label: "30 min", value: 30}, {label: "60 min", value: 60}]
                    current: win.cfg.get("idleOffMin", 0)
                    onPick: function (v) {
                        win.cfg.set("idleOffMin", v)
                        win.applyIdle(win.cfg.get("idleLockMin", 0), v)
                    }
                }
                Item { width: 1; height: 4 }
                Note {
                    text: "The keyboard switches to English before any lock, and SUPER + Space changes it on the lock screen. " +
                          "If the shell lock ever refuses your password, run  qs ipc call lock release  from a TTY (Ctrl+Alt+F3)."
                }
            }
        }
    }
}
