# ~/.zshrc — colours follow the active rice theme (see apply-colors.sh)
# -----------------------------------------------------------------------------
# PATH + env  (preserved from .bashrc)
# -----------------------------------------------------------------------------
typeset -U path PATH
path=("$HOME/.local/bin" "$HOME/bin" "$HOME/go/bin" $path)
export ANDROID_HOME="$HOME/Android/Sdk"
path+=("$ANDROID_HOME/emulator" "$ANDROID_HOME/platform-tools")
export PATH

export EDITOR="${EDITOR:-vim}"
export VISUAL="$EDITOR"
export PAGER="less"
export LESS='-R -F -X --mouse'
export CLICOLOR=1
export BAT_THEME='TwoDark'

# -----------------------------------------------------------------------------
# History
# -----------------------------------------------------------------------------
HISTFILE=~/.zsh_history
HISTSIZE=100000
SAVEHIST=100000
setopt INC_APPEND_HISTORY SHARE_HISTORY
setopt HIST_IGNORE_DUPS HIST_IGNORE_ALL_DUPS HIST_SAVE_NO_DUPS
setopt HIST_IGNORE_SPACE HIST_REDUCE_BLANKS HIST_FIND_NO_DUPS
setopt EXTENDED_HISTORY

# -----------------------------------------------------------------------------
# Options
# -----------------------------------------------------------------------------
setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS PUSHD_SILENT
setopt INTERACTIVE_COMMENTS
setopt NO_BEEP
setopt PROMPT_SUBST
setopt CORRECT

# -----------------------------------------------------------------------------
# Completion
# -----------------------------------------------------------------------------
autoload -Uz compinit
compinit -i

zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*' group-name ''

# -----------------------------------------------------------------------------
# Keybinds (emacs mode + sane history search)
# -----------------------------------------------------------------------------
bindkey -e
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey "^[[A"  up-line-or-beginning-search     # Up
bindkey "^[[B"  down-line-or-beginning-search   # Down
bindkey "^[[1;5C" forward-word                  # Ctrl+Right
bindkey "^[[1;5D" backward-word                 # Ctrl+Left
bindkey "^H"      backward-kill-word            # Ctrl+Backspace
bindkey "^[[3~"   delete-char                   # Del

# -----------------------------------------------------------------------------
# Plugins (dnf install provides these)
# -----------------------------------------------------------------------------
# Suggestion colour is overridden by the generated theme file further down.
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=8'
ZSH_AUTOSUGGEST_USE_ASYNC=1

[[ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && \
  source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh

[[ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] && \
  source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# -----------------------------------------------------------------------------
# fzf (Fedora package drops helpers in /usr/share/fzf/shell)
# -----------------------------------------------------------------------------
if command -v fzf >/dev/null 2>&1; then
  [[ -f /usr/share/fzf/shell/key-bindings.zsh ]] && source /usr/share/fzf/shell/key-bindings.zsh
  [[ -f /usr/share/fzf/shell/completion.zsh ]]   && source /usr/share/fzf/shell/completion.zsh
  # Layout only. Colours come from the theme file sourced just below, which
  # apply-colors.sh regenerates, so fzf follows the rice instead of a fixed palette.
  export FZF_BASE_OPTS="--height 40% --layout=reverse --border=sharp --prompt='❯ ' --pointer='◆' --marker='◇'"
  export FZF_DEFAULT_OPTS="$FZF_BASE_OPTS"
  command -v fd >/dev/null 2>&1 && export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
fi

# Theme-following colours for fzf + autosuggestions (generated by apply-colors.sh)
[[ -f "$HOME/.config/themes/shell-theme.zsh" ]] && source "$HOME/.config/themes/shell-theme.zsh"

# -----------------------------------------------------------------------------
# zoxide + starship
# -----------------------------------------------------------------------------
command -v zoxide   >/dev/null 2>&1 && eval "$(zoxide init zsh --cmd cd)"
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"

# -----------------------------------------------------------------------------
# Aliases
# -----------------------------------------------------------------------------
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --group-directories-first --icons=auto'
  alias ll='eza -l --group-directories-first --icons=auto --git --time-style=long-iso'
  alias la='eza -la --group-directories-first --icons=auto --git --time-style=long-iso'
  alias lt='eza --tree --level=2 --icons=auto --group-directories-first'
  alias l.='eza -ald .* --icons=auto'
else
  alias ll='ls -lh --color=auto'
  alias la='ls -lah --color=auto'
fi

command -v bat >/dev/null 2>&1 && alias cat='bat --style=plain --paging=never'
command -v btop >/dev/null 2>&1 && alias top='btop'

# safety
alias cp='cp -iv'
alias mv='mv -iv'
alias rm='rm -I'
alias mkdir='mkdir -pv'

# git
alias g='git'
alias gs='git status -sb'
alias ga='git add'
alias gc='git commit'
alias gcm='git commit -m'
alias gp='git push'
alias gpl='git pull'
alias gl='git log --oneline --graph --decorate --all -20'
alias gd='git diff'
alias gds='git diff --staged'
alias gco='git checkout'
alias gb='git branch'

# hyprland quality-of-life
alias reload-hypr='hyprctl reload'
alias rice-apply='~/.config/themes/bin/apply-colors.sh'
alias rice-theme='~/.config/themes/bin/apply-theme.sh'
alias rice-wall='~/.config/themes/bin/apply-wallpaper.sh'

# bug-bounty workflow shortcuts (user is a bug hunter)
alias serve='python3 -m http.server'
alias ports='ss -tulpn'
alias myip='curl -s https://ifconfig.me; echo'

# dotfile convenience
alias zshconfig='$EDITOR ~/.zshrc'
alias starconfig='$EDITOR ~/.config/starship.toml'
alias hyprconfig='$EDITOR ~/.config/hypr/hyprland.conf'
alias kittyconfig='$EDITOR ~/.config/kitty/kitty.conf'
alias reload='source ~/.zshrc && echo "zshrc reloaded"'

# -----------------------------------------------------------------------------
# Any user-local additions
# -----------------------------------------------------------------------------
[[ -d "$HOME/.zshrc.d" ]] && for f in "$HOME"/.zshrc.d/*.zsh(N); do source "$f"; done
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
export PATH=/opt/oracle/instantclient_23_26:$PATH
export PATH="$PATH:/opt/metasploit-framework/bin"
export PATH="$PATH:$HOME/john-jumbo/run"
alias john='/home/reouii/john-jumbo/run/john'
export PATH="$PATH:$HOME/john-jumbo/run"
